{
  "name": "osky-debate",
  "version": "0.1.0",
  "description": "Motor y CLI del sistema de debate de planeación entre IAs",
  "type": "module",
  "private": true,
  "bin": {
    "debate": "./bin/debate.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "debate": "tsx src/cli/index.ts",
    "dev": "electron-vite dev",
    "build:app": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --linux AppImage deb",
    "typecheck:app": "tsc -p tsconfig.electron.json"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.17.1",
    "chokidar": "^5.0.0",
    "commander": "^14.0.0",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "electron-builder"
    ]
  },
  "main": "out/main/index.cjs",
  "build": {
    "appId": "mx.ninja.osky-debate",
    "productName": "Osky Debate",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "oscar@ninja.com.mx",
      "desktop": {
        "entry": {
          "Name": "Osky Debate",
          "Comment": "Debate de planeación entre IAs",
          "Categories": "Development;"
        }
      }
    },
    "npmRebuild": false,
    "asar": true
  }
}
